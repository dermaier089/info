//@version=5
// Trading 212 - Tages-P&L-Verlauf (eigenes Indikatorfenster unter dem Chart)
// --------------------------------------------------------------------------
// Einrichtung: Pine Editor -> einfuegen -> "Zum Chart hinzufuegen" (landet
// automatisch in einem eigenen Fenster). Denselben "TV-Export"-String aus
// 212_Tag.html einfuegen wie beim Indikator "212 Tages-Trades".
// Gezeichnet wird der kumulierte Brutto-Gewinn/-Verlust des Tages in EUR:
// eine Stufe bei jedem Trade-Ausstieg, gruen ueber / rot unter null.
indicator("212 Tages-PnL", overlay = false, format = format.price, precision = 2)

data    = input.text_area("", "Trade-Daten (Knopf 'TV-Export' in 212_Tag.html)")
hideMic = input.bool(false, "Micro-Trades ausblenden", group = "Filter")
micPts  = input.float(5.0,  "Micro-Schwelle (Punkte)", minval = 0, step = 0.5, group = "Filter")

// --- Datenstring einmalig parsen: Ausstiegszeit, Ergebnis, Punkte (fuer den Filter) ---
var float[] aC = array.new_float()   // Close-Zeit (ms UTC)
var float[] aG = array.new_float()   // Ergebnis EUR brutto
var float[] aP = array.new_float()   // Punkte des Trades
if barstate.isfirst and str.length(data) > 0
    parts = str.split(data, "|")
    if array.size(parts) >= 3
        trs = str.split(array.get(parts, 2), ";")
        for i = 0 to array.size(trs) - 1
            f = str.split(array.get(trs, i), ",")
            if array.size(f) >= 7
                isL = array.get(f, 2) == "L"
                pE  = str.tonumber(array.get(f, 4))
                pX  = str.tonumber(array.get(f, 5))
                array.push(aC, 1000.0 * str.tonumber(array.get(f, 1)))
                array.push(aG, nz(str.tonumber(array.get(f, 6))))
                array.push(aP, (pX - pE) * (isL ? 1 : -1))

// --- Kumulierte Summe aller bis zu diesem Bar geschlossenen Trades ---
cum = 0.0
if array.size(aC) > 0
    for i = 0 to array.size(aC) - 1
        if hideMic and math.abs(array.get(aP, i)) < micPts
            continue
        if time >= int(array.get(aC, i))
            cum += array.get(aG, i)

col = cum >= 0 ? color.green : color.red
p = plot(cum, "Tages-P&L (EUR)", color = col, style = plot.style_stepline, linewidth = 2)
z = plot(0.0, "", color = color.new(color.gray, 100), editable = false, display = display.none)
fill(p, z, color = color.new(col, 85))
hline(0, "Null-Linie", color = color.new(color.gray, 50), linestyle = hline.style_dotted)
